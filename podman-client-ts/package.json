{
  "name": "podman-client",
  "version": "5.8.0",
  "type": "module",
  "description": "TypeScript bindings for the Podman RESTful API (libpod)",
  "keywords": [
    "containers",
    "docker",
    "libpod",
    "podman"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2022 --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/bun": "latest",
    "fast-check": "^3.19.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "smol-toml": "^1.3.0"
  }
}
