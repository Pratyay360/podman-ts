{
  "name": "@pratyay360/podman-ts",
  "version": "1.2.1",
  "private": false,
  "description": "TypeScript bindings for the Podman RESTful API (libpod)",
  "keywords": [
    "bun",
    "containers",
    "docker",
    "libpod",
    "podman",
    "typescript"
  ],
  "homepage": "https://github.com/Pratyay360/podman-ts#readme",
  "bugs": {
    "url": "https://github.com/Pratyay360/podman-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pratyay360/podman-ts.git"
  },
  "license": "Apache-2.0",
  "author": "pratyay360",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2022 --out-dir dist",
    "prepare": "npm run build",
    "version": "node util/versioning.cjs && git add jsr.json && npm run build && git add -A dist",
    "typecheck": "tsc --noEmit",
    "test": "npm test"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-check": "^3.23.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "module": "./dist/index.js"
}
