{
  "name": "podman-ts",
  "version": "5.8.0",
  "description": "TypeScript bindings and CLI tools for the Podman RESTful API",
  "keywords": [
    "containers",
    "docker",
    "libpod",
    "podman",
    "typescript"
  ],
  "homepage": "https://github.com/containers/podman-ts#readme",
  "bugs": {
    "url": "https://github.com/containers/podman-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containers/podman-ts.git"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "podman-ts": "dist/index.cjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2022 --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/bun": "latest",
    "fast-check": "^3.19.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "author": "pmustafi",
  "engines": {
    "bun": ">=1.0",
    "node": ">=18"
  }
}
