{
  "name": "podman-ts",
  "version": "1.0.0",
  "description": "TypeScript bindings and CLI tools for the Podman RESTful API",
  "license": "Apache-2.0",
  "author": "pmustafi",
  "workspaces": [
    "podman-client-ts"
  ],
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2022 --out-dir dist",
    "test": "bun test --cwd podman-client-ts",
    "lint": "bun run --cwd podman-client-ts lint",
    "format": "bun run --cwd podman-client-ts format"
  },
  "dependencies": {
    "podman-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  }
}
